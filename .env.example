APP_ENV=<development|staging|production>
ORDER_PORT=<order_port>
ORDER_BASE_URL=/order-service
PAYMENT_PORT=<payment_port>
PAYMENT_BASE_URL=/payment-service
INVENTORY_PORT=<inventory_port>
INVENTORY_BASE_URL=/inventory-service
DATABASE_URL=postgres://<user>:<password>@<db_host>:<db_port>/<db_name>?sslmode=disable
REDIS_URL=redis://<redis_host>:<redis_port>/<db_index>
KAFKA_BROKERS=<kafka_host>:<kafka_port>
OTLP_ENDPOINT=<otlp_host>:<otlp_port>
JWT_SECRET=<jwt_secret_key>
PAYMENT_SERVICE_URL=https://<payment_host>:<payment_Port>/payment-service
